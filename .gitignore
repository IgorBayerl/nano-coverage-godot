# ------------------------------------------------------------------------------
# GODOT ENGINE
# ------------------------------------------------------------------------------
.godot/
demo/.godot/
*.translation
*.import

# Godot Executable (if downloaded locally)
Godot_*.exe
Godot_*.zip
godot.zip
godot.app

# ------------------------------------------------------------------------------
# C++ / SCONS BUILD ARTIFACTS
# ------------------------------------------------------------------------------
# SCons cache
.sconsign.dblite
.scons_env.json

# Intermediate objects
*.o
*.os
*.obj
*.a
*.lib
*.exp
*.pdb
*.ilk
*.uid

# Compiled Dynamic Libraries
# (Ignore these so you don't commit binaries, strictly build from source)
*.so
*.dylib
*.dll
*.gdextension.zip

# ------------------------------------------------------------------------------
# DEPENDENCIES (Root Level)
# ------------------------------------------------------------------------------
# Godot-CPP generated files (Submodule artifacts)
godot-cpp/gen/
godot-cpp/bin/
godot-cpp/src/gen/

# Thirdparty Downloads
# (We ignore these because setup.py downloads them. Submodules like tree-sitter are tracked by git automatically)
thirdparty/googletest/

# ------------------------------------------------------------------------------
# NANO COVERAGE GODOT (Demo Project)
# ------------------------------------------------------------------------------

# Ignore the 'gdUnit4' folder in demo (It is a symlink/junction to thirdparty)
demo/addons/gdUnit4/

# Ignore compiled binaries for YOUR extension
# We KEEP the script files in demo/addons/nano_coverage_godot/, but ignore the binaries SCons dumps there.
demo/addons/nano_coverage_godot/bin/

# Test & Coverage Results (Generated during runtime)
demo/coverage-report/
demo/coverage-data/
demo/coverage.lcov
demo/coverage.meta
demo/coverage.data
demo/test_log.txt
demo/debug_log.txt
output_report.txt
demo/reports

# ------------------------------------------------------------------------------
# DEVELOPMENT / IDE
# ------------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# Visual Studio / JetBrains
.idea/
*.sln
*.vcxproj
*.vcxproj.user

# Clang / Compilation databases
compile_commands.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# OS generated
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# TEMPORARY
# ------------------------------------------------------------------------------
# Any temp folders created by your build/test scripts
instrumented/
temp_session_test/
scripts/setup.py

demo/nanovision.exe