[configuration]

entry_symbol = "nano_coverage_godot_library_init"
compatibility_minimum = "4.1"

[libraries]

# WINDOWS
windows.release.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.windows.template_release.x86_64.dll"

# LINUX
linux.release.x86_64 = "res://addons/nano_coverage_godot/bin/libnano_coverage_godot.linux.template_release.x86_64.so"

# MACOS
macos.release.x86_64 = "res://addons/nano_coverage_godot/bin/libnano_coverage_godot.macos.template_release.x86_64.dylib"
macos.release.arm64 = "res://addons/nano_coverage_godot/bin/libnano_coverage_godot.macos.template_release.arm64.dylib"