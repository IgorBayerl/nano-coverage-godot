[configuration]

entry_symbol = "nano_coverage_godot_library_init"
compatibility_minimum = "4.3"

[libraries]

# WINDOWS
windows.debug.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.windows.template_debug.x86_64.dll"
windows.editor.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.windows.editor.x86_64.dll"
windows.release.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.windows.template_release.x86_64.dll"

# LINUX (x86_64 and ARM64)
linux.debug.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.linux.template_release.x86_64.so"

# MACOS (Intel and Apple Silicon)
macos.debug.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.macos.template_release.x86_64.dylib"
macos.debug.arm64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://addons/nano_coverage_godot/bin/nano_coverage_godot.macos.template_release.arm64.dylib"