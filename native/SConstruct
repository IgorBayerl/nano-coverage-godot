#!/usr/bin/env python
import os
import sys

# Pylance Fix: Import SCons globals explicity for Intellisense (SCons injects them at runtime anyway)
from SCons.Script import * # type: ignore

# 1. Load Godot-CPP configuration
env = SConscript("godot-cpp/SConstruct")

# 2. Clone the environment
project_env = env.Clone()

# --- INCLUDE PATHS ---
project_env.Append(CPPPATH=[
    "src", 
    "godot-cpp/include", 
    "godot-cpp/gen/include",
    "thirdparty/tree-sitter/lib/include",
    "thirdparty/tree-sitter/lib/src",
    "thirdparty/tree-sitter-gdscript/src",
])

# --- SOURCE GATHERING ---
sources = []
test_sources = []

for root, dirs, files in os.walk("src"):
    for file in files:
        if file.endswith(".cpp"):
            path = os.path.join(root, file).replace("\\", "/")
            if file.endswith("_test.cpp") or file == "test_main.cpp":
                test_sources.append(path)
            else:
                sources.append(path)

# --- TREE-SITTER SOURCES ---
TS_LIB_C = "thirdparty/tree-sitter/lib/src/lib.c"
GDSCRIPT_PARSER_C = "thirdparty/tree-sitter-gdscript/src/parser.c"
GDSCRIPT_SCANNER_C = "thirdparty/tree-sitter-gdscript/src/scanner.c"

sources.append(TS_LIB_C)
sources.append(GDSCRIPT_PARSER_C)

if os.path.exists(GDSCRIPT_SCANNER_C):
    sources.append(GDSCRIPT_SCANNER_C)


# --- AUTOMATIC TEST CONFIGURATION ---
target_mode = project_env["target"]
arg_build_tests = ARGUMENTS.get('build_tests', 'auto')

if arg_build_tests == "yes" or (arg_build_tests == "auto" and target_mode == "template_debug"):
    print(f"[{target_mode}] Building with Tests ENABLED")
    
    GTEST_DIR = "thirdparty/googletest/googletest"
    project_env.Append(CPPPATH=[f"{GTEST_DIR}/include", f"{GTEST_DIR}"])
    project_env.Append(CPPDEFINES=['TESTS_ENABLED'])
    
    sources += test_sources
    sources.append(f"{GTEST_DIR}/src/gtest-all.cc")
else:
    print(f"[{target_mode}] Building with Tests DISABLED")

# --- OUTPUT ---
output_dir = "../godot_project/addons/nano_coverage_godot/bin/"
project_env.Execute(Mkdir(output_dir))

base_name = "nano_coverage_godot"
try:
    if 'arch' in project_env: arch = project_env['arch']
    else: arch = "x86_64"
    suffix = f".{project_env['platform']}.{project_env['target']}.{arch}"
    target_name = base_name + suffix
except KeyError:
    target_name = base_name + ".dll"

shlib_suffix = project_env.subst('$SHLIBSUFFIX')
if not target_name.endswith(shlib_suffix):
    target_name += shlib_suffix

# 3. Build Shared Library
library = project_env.SharedLibrary(
    output_dir + target_name,
    [str(s) for s in sources],
)

comp_db = project_env.CompilationDatabase(target="compile_commands.json", source=sources)

Default(library, comp_db)

# --- INSTALLATION OF RESOURCES ---
# Define the source directory for scripts/configs
addon_res_src = Dir("addon_resources")

# Define the destination directory (Root of the addon)
# output_dir is ".../bin/", so we go up one level
addon_root_dir = Dir(output_dir).Dir("..")

addon_res_src = Dir("addon_resources")

# Destination: godot_project/addons/nano_coverage_godot/
# (output_dir is ".../bin/", so we go up one level)
addon_root_dir = Dir(output_dir).Dir("..")

# Recursively copy EVERYTHING from addon_resources to the addon folder
for root, dirs, files in os.walk(str(addon_res_src)):
    for file in files:
        # Full source path (e.g., native/addon_resources/integrations/gdunit4.gd)
        source_path = os.path.join(root, file)
        
        # Relative path (e.g., integrations/gdunit4.gd)
        rel_path = os.path.relpath(source_path, str(addon_res_src))
        
        # Target node (e.g., .../addons/nano_coverage_godot/integrations/gdunit4.gd)
        target_node = addon_root_dir.File(rel_path)
        
        # InstallAs handles the copy and dependency tracking (only copies if newer)
        project_env.InstallAs(target=target_node, source=source_path)

# Ensure this runs by default
project_env.Alias("install_resources", addon_root_dir)
Default("install_resources")